{
  "name": "agent-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Academy — a comprehensive, interactive course on AI agents.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node guide/build.mjs",
    "serve": "npx --yes http-server docs -p 8080 -c-1",
    "dev": "node scripts/build.mjs && npx --yes http-server docs -p 8080 -c-1",
    "qa": "node scripts/qa.cjs",
    "check-code": "python3 scripts/check_code.py",
    "check-quizzes": "node scripts/quiz-stats.mjs",
    "check-examples": "python3 scripts/run_examples.py",
    "check-citations": "python3 scripts/check_citations.py",
    "build:academy": "node scripts/build.mjs",
    "build:guide": "node guide/build.mjs"
  },
  "devDependencies": {
    "highlight.js": "^11.10.0",
    "js-yaml": "^4.1.0",
    "marked": "^14.1.0",
    "mermaid": "^11.4.0"
  }
}
